  "guard_steps": 30,
  "sample_interval_seconds": 10,
  "feature_dtype": "float32",
  "max_placement_attempts": 1000,
  "allow_band_overlap": false,
  "realized_ratio_tol": 0.0001,
  "realized_offset_tol": 0.001,
